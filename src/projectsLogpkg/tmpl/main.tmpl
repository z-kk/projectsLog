#? stdtmpl | standard
#proc mainPageBody(inputTable: string): string =
#  let today = now()
#  result = ""
<form>
    <label>対象日: 
        <input type="date" id="day" name="day" value="${today.format(DateFormat)}"/>
    </label>
    <div id="inputtable" class="table">${inputTable}</div>
    <datalist id="dlist"></datalist>
    <button type="button" id="okbtn" onclick="update()">OK</button>
</form>
<dialog>
    <button class="close-btn" onclick="closeDialog()">&times;</button>
    <div>
        <label>期間: 
            <input type="date" id="from_day" name="from_day" value="${today.format(DateFormat)}"/>
        </label>
        <span>～</span>
        <input type="date" id="to_day" name="to_day" value="${today.format(DateFormat)}"/>
        <button type="button" id="updatebtn" onclick="update()">更新</button>
    </div>
    <div id="calctable" class="table"></div>
</dialog>
